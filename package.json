{
  "name": "@pplancq/lab-clean-architecture-react",
  "version": "0.1.0",
  "license": "MIT",
  "description": "A living laboratory exploring Clean Architecture patterns in React through a real-world game collection management application.",
  "author": "Paul PLANCQ <paul.plancq@outlook.fr>",
  "repository": {
    "type": "git",
    "url": "https://github.com/pplancq/lab-clean-architecture-react"
  },
  "packageManager": "npm@12.0.1",
  "type": "module",
  "scripts": {
    "start": "rsbuild dev",
    "start:mock": "rsbuild dev --env-mode mock",
    "build": "rsbuild build",
    "preview": "rsbuild preview",
    "test": "node scripts/test.js",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "node scripts/playwright.js test",
    "test:e2e:watch": "node scripts/playwright.js test --watch",
    "test:e2e:ui": "node scripts/playwright.js test --ui",
    "lint": "node scripts/lint.js",
    "lint:eslint": "eslint \"{mocks,public,src,tests}/**/*.{js,jsx,mjs,ts,tsx}\"",
    "lint:eslint:fix": "eslint \"{mocks,public,src,tests}/**/*.{js,jsx,mjs,ts,tsx}\" --fix",
    "lint:stylelint": "stylelint \"src/**/*.{scss,css}\"",
    "lint:stylelint:fix": "stylelint \"src/**/*.{scss,css}\" --fix",
    "lint:prettier": "prettier \"{mocks,public,src}/**/*.!(js|jsx|mjs|ts|tsx|scss|css)\" --check --ignore-unknown",
    "lint:prettier:fix": "prettier \"{mocks,public,src}/**/*.!(js|jsx|mjs|ts|tsx|scss|css)\" --write --ignore-unknown",
    "lint:tsc": "tsc --noEmit",
    "playwright:install": "playwright install",
    "playwright:show-report": "playwright show-report",
    "playwright:codegen": "playwright codegen",
    "package:check": "npm exec --yes package-lock-utd@1.1.3",
    "prepare": "husky",
    "postinstall": "msw init"
  },
  "dependencies": {
    "@hookform/devtools": "^4.4.0",
    "@hookform/resolvers": "^5.4.0",
    "@pplancq/shelter-ui-css": "^1.0.0-alpha.7",
    "@pplancq/shelter-ui-icon": "^1.0.0-alpha.7",
    "@pplancq/shelter-ui-react": "^1.0.0-alpha.7",
    "@pplancq/svg-react": "^3.0.12",
    "@tanstack/react-query": "^5.101.3",
    "@tanstack/react-query-devtools": "^5.101.3",
    "inversify": "^8.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.82.0",
    "react-router": "^8.2.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@bdellegrazie/playwright-sonar-reporter": "^0.5.2",
    "@commitlint/cli": "^21.2.1",
    "@msw/playwright": "^0.6.7",
    "@playwright/test": "^1.61.1",
    "@pplancq/commitlint-config": "^4.0.2",
    "@pplancq/eslint-config": "^6.0.17",
    "@pplancq/postcss-config": "^3.0.6",
    "@pplancq/prettier-config": "^3.0.0",
    "@pplancq/stylelint-config": "^5.0.3",
    "@rsbuild/core": "^2.1.7",
    "@rsbuild/plugin-eslint": "^2.0.2",
    "@rsbuild/plugin-react": "^2.1.0",
    "@rsbuild/plugin-sass": "^2.0.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^10.0.3",
    "eslint": "^9.39.5",
    "eslint-plugin-prettier": "^5.5.6",
    "fake-indexeddb": "^6.2.5",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.1.0",
    "monocart-coverage-reports": "^2.12.12",
    "msw": "^2.15.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "rsbuild-plugin-stylelint": "^1.2.0",
    "stylelint": "^17.14.1",
    "stylelint-prettier": "^5.0.3",
    "tsc-files": "^1.1.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "vitest-axe": "^1.0.0-pre.5",
    "vitest-sonar-reporter": "^3.0.0"
  },
  "overrides": {
    "rsbuild-plugin-stylelint": {
      "stylelint": "$stylelint"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "msw": {
    "workerDirectory": [
      "./public"
    ]
  }
}
